{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_PREVIOUS_SHA\" ] && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" \"$VERCEL_GIT_COMMIT_SHA\" -- ./api/ ./vercel.json ./.vercelignore",
  "redirects": [
    {
      "source": "/",
      "destination": "https://kbkaran.com/f1-pitwall/",
      "permanent": true
    },
    {
      "source": "/:path((?!api$|api/).*)",
      "destination": "https://kbkaran.com/f1-pitwall/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    }
  ]
}
