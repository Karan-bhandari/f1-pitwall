# Ignore everything at root (frontend, Cloudflare Worker, Node/Vite, tests, docs)
/*

# Whitelist only Vercel routing config and Python API backend
!vercel.json
!api/

# Exclude local-only scripts, caches, and bytecode inside api/
api/instance/
api/run.py
api/warm_cache.py
__pycache__/
*.py[cod]
.DS_Store
