# Formula 1 / F1TV Account Credentials for FastF1 3.9+ LiveTiming Auth
# Copy this file to .env and fill in your credentials locally, or set them in
# Vercel / Google Cloud Run environment variables.
F1_USERNAME=
F1_PASSWORD=
FASTF1_AUTH_METHOD=password

# Cloudflare Worker -> Python Origin Gateway (Stage 1: Vercel, Stage 2: Cloud Run)
# Leave empty in local dev to default to http://127.0.0.1:5005 without a secret.
BACKEND_ORIGIN=
PITWALL_ORIGIN_SECRET=
